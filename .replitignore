# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Generated APKs and other build outputs.
/generated-artifacts/

# Android Gradle/CMake outputs are only needed for local APK builds, not the
# published Expo bundles or API server. Keep node_modules dependencies available.
**/android/app/build/
**/android/app/.cxx/
**/android/build/
**/android/.cxx/
